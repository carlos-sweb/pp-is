{
  "name": "pp-is",
  "description": "Collection of methods for check",
  "version": "2.0.0",
  "main": "./dist/pp-is.cjs",
  "exports": {
    ".": {
      "bun": "./src/pp-is.js",
      "browser": "./dist/pp-is.mjs",
      "import": "./dist/pp-is.mjs",
      "require": "./dist/pp-is.cjs",
      "default": "./dist/pp-is.cjs"
    }
  },
  "scripts": {
    "build": "bun run scripts/build.mjs",
    "djs": "documentation build ./src/pp-is.js -f html -o ./djs && php -S localhost:8091 -t ./djs",
    "docs": "jsdoc ./src/pp-is.js -d docs && php -S localhost:8091 -t ./docs",
    "test": "bun test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carlos-sweb/pp-is.git"
  },
  "keywords": [
    "isArray",
    "isBoolean",
    "isDate",
    "isFunction",
    "isNull",
    "isNumber",
    "isObject",
    "isString",
    "isUndefined",
    "isElement",
    "isEmpty",
    "isEmail",
    "isNaN",
    "isRegExp",
    "isUrl",
    "isHTMLCollection",
    "isNodeList",
    "isBlank",
    "isPromise",
    "isNil",
    "isSymbol",
    "isBigInt",
    "isInteger",
    "isFinite",
    "isPositive",
    "isNegative",
    "isAlpha",
    "isAlphanumeric",
    "isNumericString",
    "isLowercase",
    "isUppercase",
    "isHexColor",
    "isJSON",
    "isUUID",
    "isIPv4",
    "isIterable",
    "isTruthy",
    "isFalsy",
    "isCallable",
    "isAsyncFunction",
    "isPromiseLike",
    "isFrozen",
    "isSealed"
  ],
  "author": "Carlos Illesca",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/carlos-sweb/pp-is/issues"
  },
  "homepage": "https://github.com/carlos-sweb/pp-is#readme"
}
